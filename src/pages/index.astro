---
import Layout from '../layouts/Layout.astro';

const workItems = [
	{
		number: '01',
		type: 'Experience',
		title: 'DRAM Test Solution Engineer Intern',
		meta: 'Micron · TSE-DRAM / Probe Global Central Team',
		period: 'Linux · REST API · Backend · DRAM/HBM',
		content: [
			'Developed a Post Monitor Tool for DRAM/HBM Test Program post-release monitoring and revision comparison, analyzing wafer-level yield, bin distribution, and electrical test trends.',
		],
		highlights: [
			'Built the backend and database pipeline in a Linux environment, handling large-scale test data through data parsing, processing, and ingestion for automated monitoring and analysis.',
			'Implemented automated statistical analysis, anomaly detection, visualization, and alarm mechanisms to identify potential test issues and accelerate engineering root-cause analysis.',
		],
	},
	{
		number: '02',
		type: 'Embedded Robotics',
		title: 'Balloon Pop Bot: Embedded Vision-Guided Tracking Robot',
		meta: 'Embedded robotics platform',
		period: 'ROS · YOLOv8 · Edge Device',
		content: [
			'Developed an embedded robotics platform that combines edge-based computer vision, autonomous tracking, and physical actuation.',
		],
		highlights: [
			'Integrated ROS with a lightweight YOLOv8 model on an edge device for real-time balloon detection and tracking.',
			'Connected vision output to robot motion control for autonomous target pursuit.',
			'Designed and integrated a servo-driven balloon-popping mechanism.',
		],
		links: [
			{ label: 'Watch Demo', href: 'https://www.youtube.com/watch?v=YYZG2IyykVk' },
			{ label: 'View on GitHub', href: 'https://github.com/linnnz19/Balloon-Pop-Bot-Embedded-Vision-Guided-Tracking-Robot' },
			{ label: 'HackMD', href: 'https://hackmd.io/@suxMuBPuSgKN4_jZIzSXrw/BalloonPopBot_HungYiLin' },
		],
	},
	{
		number: '03',
		type: 'Reinforcement Learning',
		title: 'Actor-Critic & PPO Algorithms in Unity-Based Push Block Task',
		meta: 'Multi-agent reinforcement learning simulation',
		period: 'Unity · C# · PPO · A2C',
		content: [
			'Developed a multi-agent reinforcement learning simulation in Unity to evaluate cooperative physical tasks.',
		],
		highlights: [
			'Designed custom C# reward shaping for time penalties and impulse transfer.',
			'Applied PPO and A2C to jointly optimize individual navigation and multi-agent coordination.',
			'Overcame the convergence failures observed in baseline DQN models within the cooperative environment.',
		],
		links: [
			{ label: 'A2C Demo', href: 'https://www.youtube.com/watch?v=zhK_aJ8iDVg' },
			{ label: 'PPO Demo', href: 'https://www.youtube.com/watch?v=NMPVtYbDH9A' },
			{ label: 'View on GitHub', href: 'https://github.com/linnnz19/A-Implementation-Case-of-Actor-Critic-and-PPO-Algorithms-in-Unity-Based-Push-Block-Task' },
		],
	},
	{
		number: '04',
		type: 'Evolutionary Computation',
		title: 'Optimal Resource Allocation in Container-Based Environments Using Genetic Algorithms',
		meta: 'Heterogeneous cluster simulation',
		period: 'NSGA-II · Containers · Microservices',
		content: [
			'Developed a container-based resource allocation simulation system for heterogeneous clusters.',
		],
		highlights: [
			'Modeled realistic cluster monitoring and microservice interactions.',
			'Applied an NSGA-II–based multi-objective evolutionary algorithm to optimize communication overhead and node resource utilization.',
			'Outperformed the traditional greedy algorithm by 37% in overall efficiency.',
		],
		links: [
			{ label: 'View on GitHub', href: 'https://github.com/linnnz19/Resource-Allocation-Methods-in-Container-Based-Environment' },
		],
	},
	{
		number: '05',
		type: 'Queueing Theory',
		title: 'AoI Minimization in Single Source Node System',
		meta: 'Queueing Theory course project',
		period: 'Backward Dynamic Programming · MDP',
		content: [
			'Modeled an Age of Information minimization problem as a Markov Decision Problem for a Queueing Theory course project.',
		],
		highlights: [
			'Simulated information freshness in a single-source system.',
			'Implemented a backward dynamic programming algorithm.',
			'Derived optimal policies using high-level dynamic programming principles.',
		],
		links: [
			{ label: 'View on GitHub', href: 'https://github.com/linnnz19/AoI-Minimization-in-Single-Source-Node-System' },
			{ label: 'View Report', href: '/Queueing_Theory_Project.pdf' },
		],
	},
	{
		number: '06',
		type: 'NTPU Senior Project',
		title: 'Incentive Design for Cooperative Cognitive Radio Networks',
		meta: 'Cooperative cognitive radio networks',
		period: 'Game Theory · Stackelberg Leading Model',
		content: [
			'Investigated incentive mechanisms for cooperative cognitive radio networks through a game-theoretic system model.',
		],
		highlights: [
			'Analyzed network interactions using a Stackelberg leader–follower model.',
			'Applied game theory to cooperative communication-system design.',
			'Explored a transaction-free mechanism intended to maximize user satisfaction.',
		],
		links: [
			{ label: 'View Poster', href: '/NTPU_senior_project_Otto%20Lin.pdf' },
		],
	},
];

const workPages = [workItems.slice(0, 3), workItems.slice(3, 6)];

const gallery = [
	{ src: '/images/landing/SCRL_0009.jpg', alt: 'Portrait at a café' },
	{ src: '/images/landing/SCRL_0008.jpg', alt: 'Forest photography self-portrait' },
	{ src: '/images/landing/SCRL_0007.jpg', alt: 'Iceland coastline travel journal' },
	{ src: '/images/landing/SCRL_0006.jpg', alt: 'Blue winter landscape in Iceland' },
	{ src: '/images/landing/SCRL_0005.jpg', alt: 'Exploring a glacier in Iceland' },
	{ src: '/images/landing/SCRL_0004.jpg', alt: 'Travel memories in Budapest' },
	{ src: '/images/landing/SCRL_0003.jpg', alt: 'The Matterhorn in Zermatt' },
	{ src: '/images/landing/SCRL_0002.jpg', alt: 'Travel memories in Malta' },
	{ src: '/images/landing/SCRL_0001.jpg', alt: 'Summer internship memories at Micron' },
];
---

<Layout
	title="Hung-Yi Lin — Electrical Engineering @ NCHU"
	description="Hung-Yi Lin is an electrical engineering graduate student at NCHU interested in embedded systems, game theory, and end-to-end products."
>
	<header class="site-header">
		<a class="brand" href="#top" aria-label="Ottolin, back to top">
			<span aria-hidden="true"></span>Hung-Yi Lin
		</a>
		<nav aria-label="Primary navigation">
			<a href="#about">About Me</a>
			<a href="#projects">Projects</a>
		</nav>
		<button class="theme-toggle" type="button" aria-label="Switch color theme" data-theme-toggle>◐</button>
	</header>

	<main id="top">
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<h1 id="hero-title">Otto Lin</h1>
				<p class="role">
					<span>Department of Electrical Engineering @ NCHU</span>
					<span>Ex-DRAM Test Solution Engineer Intern @ Micron</span>
				</p>
				<p class="intro">Maker. Photographer. Swimmer.</p>
				<div class="quick-links" aria-label="Professional links">
					<a href="/OttoLin_CV.pdf" target="_blank">CV</a>
					<a href="https://www.linkedin.com/in/ottolin0419/" target="_blank" rel="noreferrer">LinkedIn</a>
					<a href="mailto:ottolin1688@gmail.com">Email</a>
					<a href="https://github.com/linnnz19" target="_blank" rel="noreferrer">Github</a>
				</div>
			</div>

			<div class="photo-carousel" data-carousel>
				<div class="carousel-viewport" data-carousel-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label="Selected moments">
					<div class="carousel-track">
						{gallery.map((photo, index) => (
							<figure class="carousel-slide" data-carousel-slide aria-label={`${index + 1} of ${gallery.length}`}>
								<img src={photo.src} alt={photo.alt} width="1200" height="1600" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
							</figure>
						))}
					</div>
				</div>
				<div class="carousel-meta">
					<p class="carousel-counter" aria-live="polite"><span data-carousel-current>01</span><span aria-hidden="true"> / </span><span>09</span></p>
					<div class="carousel-dots" aria-label="Choose a photo">
						{gallery.map((_, index) => (
							<button type="button" data-carousel-dot aria-label={`Show photo ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'}></button>
						))}
					</div>
					<div class="carousel-controls">
						<button type="button" data-carousel-prev aria-label="Previous photo">←</button>
						<button type="button" data-carousel-next aria-label="Next photo">→</button>
					</div>
				</div>
			</div>
		</section>

		<section class="about-section" id="about" aria-labelledby="about-title">
			<p class="section-label">I / About Me</p>
			<div class="about-copy">
				<h2 id="about-title">KHH, TW</h2>
				<article class="about-letter" aria-label="A short introduction from Otto">
					<div class="letter-meta">
						<span>From</span><strong>Otto Lin</strong>
						<span>Subject</span><strong>A little about me</strong>
					</div>
					<div class="letter-body">
						<p class="letter-greeting">Dear Visitor,</p>
						<p>Nice to meet you here! I'm Otto. Thanks for stopping by my little corner of the internet &gt;&lt;</p>
						<p>If I had to describe myself in three words, I'd say thoughtful, responsible, and always eager to learn. It's a mindset I try to bring into everything I do, whether I'm studying, working with others, or turning an idea into something real.</p>
						<p>Beyond academics, you'll usually find me traveling, swimming, cooking, taking photographs, or carefully piecing together a Gunpla kit. At heart, I'm also a maker, always happiest when I'm soldering, coding, and turning small ideas into real, working things.</p>
						<p>Thanks again for visiting! Please feel free to reach out anytime.</p>
						<div class="email-code">
							<a href="mailto:ottolin1688@gmail.com"><code>ottolin1688@gmail.com</code></a>
							<button class="copy-email" type="button" data-copy-email aria-label="Copy email address" title="Copy email address">
								<span class="copy-glyph" aria-hidden="true"><span></span><span></span></span>
								<span class="copy-check" aria-hidden="true">✓</span>
								<span class="visually-hidden" data-copy-label aria-live="polite">Copy email address</span>
							</button>
						</div>
						<p class="letter-signature">Warmly,<br />Otto</p>
					</div>
				</article>
			</div>
		</section>

		<section class="focus-section" id="projects" aria-labelledby="focus-title">
			<div class="section-title">
				<p>II / Project & Experience</p>
				<h2 id="focus-title">Things I've done...</h2>
			</div>

			<div class="work-carousel" data-work-carousel>
				<div class="work-viewport" data-work-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label="Projects and experience">
					<div class="work-track">
						{workPages.map((page, pageIndex) => (
							<div class="work-page" data-work-page aria-label={`Page ${pageIndex + 1} of ${workPages.length}`} aria-hidden={pageIndex !== 0 ? 'true' : 'false'} inert={pageIndex !== 0}>
								<div class="work-list" data-work-accordion>
									{page.map((item) => (
										<details class="work-item" data-work-item>
											<summary>
												<span class="number">{item.number}</span>
												<span class="work-heading">
													<span class="type">{item.type}</span>
													<h3>{item.title}</h3>
												</span>
												<span class="work-meta">
													<span>{item.meta}</span>
													<span class="tech-stack">{item.period}</span>
												</span>
												<span class="work-toggle" aria-hidden="true"><span></span><span></span></span>
											</summary>
											<div class:list={['work-body', item.highlights.length === 0 && 'work-body--single']}>
												<div class="work-copy">
													<div class="work-brief">
														<span class="work-brief-label">Project brief</span>
														{item.content.map((paragraph) => <p>{paragraph}</p>)}
													</div>
													{'links' in item && item.links && <div class="work-links" aria-label={`${item.title} resources`}>
														{item.links.map((link) => (
															<a href={link.href} target="_blank" rel="noreferrer">
																<span>{link.label}</span><span aria-hidden="true">↗</span>
															</a>
														))}
													</div>}
												</div>
												{item.highlights.length > 0 && <div class="work-highlights">
													<span class="work-highlights-label">Key outcomes</span>
													<ul>
														{item.highlights.map((highlight) => <li><span class="outcome-mark" aria-hidden="true">✦</span><p>{highlight}</p></li>)}
													</ul>
												</div>}
											</div>
										</details>
									))}
								</div>
							</div>
						))}
					</div>
				</div>

				<div class="work-pagination">
					<div class="work-page-dots" aria-label="Choose a project page">
						<button type="button" data-work-dot aria-label="Show projects 1 through 3" aria-current="true"><span>01—03</span></button>
						<button type="button" data-work-dot aria-label="Show projects 4 through 6" aria-current="false"><span>04—06</span></button>
					</div>
					<p class="work-gesture" aria-hidden="true">Swipe to explore</p>
					<div class="work-controls">
						<button type="button" data-work-prev aria-label="Previous project page">←</button>
						<button type="button" data-work-next aria-label="Next project page">→</button>
					</div>
				</div>
			</div>
		</section>

	</main>

	<footer>
		<span>© {new Date().getFullYear()} Hung-Yi Lin</span>
		<a href="#top">Back to top ↑</a>
	</footer>

	<script>
		const root = document.documentElement;
		const button = document.querySelector('[data-theme-toggle]');
		const saved = localStorage.getItem('portfolio-theme');
		if (saved === 'light') root.dataset.theme = 'light';
		button?.addEventListener('click', () => {
			const next = root.dataset.theme === 'light' ? 'dark' : 'light';
			root.dataset.theme = next;
			localStorage.setItem('portfolio-theme', next);
		});

		const copyEmailButton = document.querySelector('[data-copy-email]');
		const copyEmailLabel = copyEmailButton?.querySelector('[data-copy-label]');
		let copyResetTimer = 0;
		copyEmailButton?.addEventListener('click', async () => {
			if (!(copyEmailButton instanceof HTMLButtonElement) || !(copyEmailLabel instanceof HTMLElement)) return;
			try {
				await navigator.clipboard.writeText('ottolin1688@gmail.com');
				copyEmailLabel.textContent = 'Email address copied';
				copyEmailButton.setAttribute('aria-label', 'Email address copied');
				copyEmailButton.setAttribute('title', 'Copied');
				copyEmailButton.dataset.state = 'copied';
			} catch {
				copyEmailLabel.textContent = 'Unable to copy email address';
				copyEmailButton.setAttribute('aria-label', 'Unable to copy email address');
				copyEmailButton.setAttribute('title', 'Unable to copy');
			}
			window.clearTimeout(copyResetTimer);
			copyResetTimer = window.setTimeout(() => {
				copyEmailLabel.textContent = 'Copy email address';
				copyEmailButton.setAttribute('aria-label', 'Copy email address');
				copyEmailButton.setAttribute('title', 'Copy email address');
				delete copyEmailButton.dataset.state;
			}, 1800);
		});

			document.querySelectorAll('[data-carousel]').forEach((carousel) => {
			const viewport = carousel.querySelector('[data-carousel-viewport]');
			const slides = [...carousel.querySelectorAll('[data-carousel-slide]')];
			const dots = [...carousel.querySelectorAll('[data-carousel-dot]')];
			const currentLabel = carousel.querySelector('[data-carousel-current]');
			const previousButton = carousel.querySelector('[data-carousel-prev]');
			const nextButton = carousel.querySelector('[data-carousel-next]');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			let currentIndex = 0;
			let scrollFrame = 0;
			let dragging = false;
			let dragStartX = 0;
			let dragStartScroll = 0;
			let targetIndex = null;
			let viewportWidth = viewport.clientWidth;

			if (!(viewport instanceof HTMLElement)) return;

			const updateUI = (index) => {
				currentIndex = Math.max(0, Math.min(index, slides.length - 1));
				if (currentLabel) currentLabel.textContent = String(currentIndex + 1).padStart(2, '0');
				dots.forEach((dot, dotIndex) => dot.setAttribute('aria-current', String(dotIndex === currentIndex)));
				if (previousButton instanceof HTMLButtonElement) previousButton.disabled = currentIndex === 0;
				if (nextButton instanceof HTMLButtonElement) nextButton.disabled = currentIndex === slides.length - 1;
				slides.forEach((slide, slideIndex) => slide.setAttribute('aria-hidden', String(slideIndex !== currentIndex)));
			};

			const goTo = (index, behavior = 'smooth') => {
				const nextIndex = Math.max(0, Math.min(index, slides.length - 1));
				targetIndex = nextIndex;
				viewport.scrollTo({ left: nextIndex * viewport.clientWidth, behavior: reduceMotion.matches ? 'auto' : behavior });
				updateUI(nextIndex);
			};

			previousButton?.addEventListener('click', () => goTo(currentIndex - 1));
			nextButton?.addEventListener('click', () => goTo(currentIndex + 1));
			dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));

			viewport.addEventListener('keydown', (event) => {
				if (!(event instanceof KeyboardEvent)) return;
				if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(currentIndex - 1); }
				if (event.key === 'ArrowRight') { event.preventDefault(); goTo(currentIndex + 1); }
				if (event.key === 'Home') { event.preventDefault(); goTo(0); }
				if (event.key === 'End') { event.preventDefault(); goTo(slides.length - 1); }
			});

			viewport.addEventListener('scroll', () => {
				cancelAnimationFrame(scrollFrame);
				scrollFrame = requestAnimationFrame(() => {
					if (targetIndex !== null) {
						const reachedTarget = Math.abs(viewport.scrollLeft - targetIndex * viewport.clientWidth) < 2;
						if (reachedTarget) targetIndex = null;
						return;
					}
					const index = Math.round(viewport.scrollLeft / viewport.clientWidth);
					if (index !== currentIndex) updateUI(index);
				});
			}, { passive: true });

			viewport.addEventListener('pointerdown', (event) => {
				targetIndex = null;
				if (!(event instanceof PointerEvent) || event.pointerType === 'touch') return;
				dragging = true;
				dragStartX = event.clientX;
				dragStartScroll = viewport.scrollLeft;
				viewport.classList.add('is-dragging');
				viewport.setPointerCapture(event.pointerId);
			});

			viewport.addEventListener('pointermove', (event) => {
				if (!dragging || !(event instanceof PointerEvent)) return;
				viewport.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
			});

			const finishDrag = (event) => {
				if (!dragging) return;
				dragging = false;
				viewport.classList.remove('is-dragging');
				if (event instanceof PointerEvent && viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
				goTo(Math.round(viewport.scrollLeft / viewport.clientWidth));
			};

			viewport.addEventListener('pointerup', finishDrag);
			viewport.addEventListener('pointercancel', finishDrag);
			viewport.addEventListener('touchstart', () => { targetIndex = null; }, { passive: true });
			viewport.addEventListener('wheel', () => { targetIndex = null; }, { passive: true });

			const resizeObserver = new ResizeObserver(() => {
				const nextWidth = viewport.clientWidth;
				if (Math.abs(nextWidth - viewportWidth) < 1) return;
				const visibleIndex = viewportWidth > 0
					? Math.round(viewport.scrollLeft / viewportWidth)
					: currentIndex;
				viewportWidth = nextWidth;
				goTo(visibleIndex, 'auto');
			});
			resizeObserver.observe(viewport);
			updateUI(0);
		});

		document.querySelectorAll('[data-work-carousel]').forEach((carousel) => {
			const viewport = carousel.querySelector('[data-work-viewport]');
			const pages = [...carousel.querySelectorAll('[data-work-page]')];
			const dots = [...carousel.querySelectorAll('[data-work-dot]')];
			const previousButton = carousel.querySelector('[data-work-prev]');
			const nextButton = carousel.querySelector('[data-work-next]');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			let currentIndex = 0;
			let scrollFrame = 0;
			let targetIndex = null;

			if (!(viewport instanceof HTMLElement) || pages.length === 0) return;

			const fitActivePage = () => {
				const page = pages[currentIndex];
				if (page instanceof HTMLElement) viewport.style.height = `${page.scrollHeight}px`;
			};

			const updateUI = (index) => {
				const nextIndex = Math.max(0, Math.min(index, pages.length - 1));
				if (nextIndex !== currentIndex) {
					const departingPage = pages[currentIndex];
					departingPage?.querySelectorAll('details[open]').forEach((item) => item.removeAttribute('open'));
				}
				currentIndex = nextIndex;
				dots.forEach((dot, dotIndex) => dot.setAttribute('aria-current', String(dotIndex === currentIndex)));
				pages.forEach((page, pageIndex) => {
					page.setAttribute('aria-hidden', String(pageIndex !== currentIndex));
					page.toggleAttribute('inert', pageIndex !== currentIndex);
				});
				if (previousButton instanceof HTMLButtonElement) previousButton.disabled = currentIndex === 0;
				if (nextButton instanceof HTMLButtonElement) nextButton.disabled = currentIndex === pages.length - 1;
				requestAnimationFrame(fitActivePage);
			};

			const goTo = (index, behavior = 'smooth') => {
				const nextIndex = Math.max(0, Math.min(index, pages.length - 1));
				targetIndex = nextIndex;
				viewport.scrollTo({ left: nextIndex * viewport.clientWidth, behavior: reduceMotion.matches ? 'auto' : behavior });
				updateUI(nextIndex);
			};

			previousButton?.addEventListener('click', () => goTo(currentIndex - 1));
			nextButton?.addEventListener('click', () => goTo(currentIndex + 1));
			dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));

			viewport.addEventListener('keydown', (event) => {
				if (!(event instanceof KeyboardEvent)) return;
				if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(currentIndex - 1); }
				if (event.key === 'ArrowRight') { event.preventDefault(); goTo(currentIndex + 1); }
				if (event.key === 'Home') { event.preventDefault(); goTo(0); }
				if (event.key === 'End') { event.preventDefault(); goTo(pages.length - 1); }
			});

			viewport.addEventListener('scroll', () => {
				cancelAnimationFrame(scrollFrame);
				scrollFrame = requestAnimationFrame(() => {
					if (targetIndex !== null) {
						const reachedTarget = Math.abs(viewport.scrollLeft - targetIndex * viewport.clientWidth) < 2;
						if (reachedTarget) targetIndex = null;
						return;
					}
					const index = Math.round(viewport.scrollLeft / viewport.clientWidth);
					if (index !== currentIndex) updateUI(index);
				});
			}, { passive: true });

			viewport.addEventListener('touchstart', () => { targetIndex = null; }, { passive: true });
			viewport.addEventListener('wheel', (event) => {
				if (event instanceof WheelEvent && Math.abs(event.deltaX) > Math.abs(event.deltaY)) targetIndex = null;
			}, { passive: true });

			const resizeObserver = new ResizeObserver(fitActivePage);
			pages.forEach((page) => resizeObserver.observe(page));
			window.addEventListener('resize', () => {
				viewport.scrollTo({ left: currentIndex * viewport.clientWidth, behavior: 'auto' });
				fitActivePage();
			}, { passive: true });
			updateUI(0);
			document.fonts?.ready.then(fitActivePage);
		});

		document.querySelectorAll('[data-work-accordion]').forEach((accordion) => {
			const items = [...accordion.querySelectorAll('[data-work-item]')].filter((item): item is HTMLDetailsElement => item instanceof HTMLDetailsElement);
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			const intendedState = new WeakMap<HTMLDetailsElement, boolean>();
			const itemAnimations = new WeakMap<HTMLDetailsElement, Animation>();
			const contentAnimations = new WeakMap<HTMLDetailsElement, Animation>();

			const animateItem = (item: HTMLDetailsElement, shouldOpen: boolean) => {
				const summary = item.querySelector('summary');
				const body = item.querySelector('.work-body');
				if (!(summary instanceof HTMLElement) || !(body instanceof HTMLElement)) return;

				itemAnimations.get(item)?.cancel();
				contentAnimations.get(item)?.cancel();
				const startHeight = item.offsetHeight;
				intendedState.set(item, shouldOpen);

				if (shouldOpen) item.open = true;
				if (reduceMotion.matches) {
					item.open = shouldOpen;
					item.style.height = '';
					item.style.overflow = '';
					return;
				}

				const endHeight = shouldOpen ? summary.offsetHeight + body.scrollHeight : summary.offsetHeight;
				item.style.height = `${startHeight}px`;
				item.style.overflow = 'clip';
				item.style.willChange = 'height';

				const itemAnimation = item.animate(
					{ height: [`${startHeight}px`, `${endHeight}px`] },
					{ duration: shouldOpen ? 460 : 360, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
				);
				const contentAnimation = body.animate(
					shouldOpen
						? [{ opacity: 0, transform: 'translateY(-0.4rem)' }, { opacity: 1, transform: 'translateY(0)' }]
						: [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-0.25rem)' }],
					{ duration: shouldOpen ? 340 : 190, delay: shouldOpen ? 70 : 0, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' },
				);

				itemAnimations.set(item, itemAnimation);
				contentAnimations.set(item, contentAnimation);
				itemAnimation.addEventListener('finish', () => {
					if (itemAnimations.get(item) !== itemAnimation) return;
					item.open = shouldOpen;
					contentAnimation.cancel();
					item.style.height = '';
					item.style.overflow = '';
					item.style.willChange = '';
					itemAnimations.delete(item);
					contentAnimations.delete(item);
				});
			};

			items.forEach((item) => {
				intendedState.set(item, item.open);
				const summary = item.querySelector('summary');
				summary?.addEventListener('click', (event) => {
					event.preventDefault();
					const shouldOpen = !intendedState.get(item);
					if (shouldOpen) {
						items.forEach((otherItem) => {
							if (otherItem !== item && intendedState.get(otherItem)) animateItem(otherItem, false);
						});
					}
					animateItem(item, shouldOpen);
				});
				});
			});
		</script>
</Layout>

